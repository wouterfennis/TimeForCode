<Project>

  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <!-- Verify maintenance fee: open source project without revenue. Renew before the month passes. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <!-- TFC0001: a // comment directly above a declaration fails the build; use an XML doc (///). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'TimeForCode.Shared.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Shared/TimeForCode.Shared.Analyzers/TimeForCode.Shared.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
