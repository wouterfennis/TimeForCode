    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="MongoDB.Bson" Version="3.13.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
