{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "donation": {
        "ClusterId": "donation",
        "Match": { "Path": "/api/donation/{**rest}" },
        "Metadata": { "PublicPathPrefix": "/api/donation/" },
        "Transforms": [
          { "PathPattern": "/api/{**rest}" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeader": "Cache-Control", "Set": "no-store", "When": "Always" }
        ]
      },
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**rest}" },
        "Metadata": { "PublicPathPrefix": "/api/auth/" },
        "Transforms": [
          { "PathPattern": "/api/{**rest}" },
          { "RequestHeaderRemove": "Authorization" },
          { "ResponseHeader": "Cache-Control", "Set": "no-store", "When": "Always" }
        ]
      }
    },
    "Clusters": {
      "donation": {
        "Destinations": { "api": { "Address": "http://donation-api:8080" } }
      },
      "auth": {
        "Destinations": { "api": { "Address": "http://authorization-api:8080" } }
      }
    }
  }
}
