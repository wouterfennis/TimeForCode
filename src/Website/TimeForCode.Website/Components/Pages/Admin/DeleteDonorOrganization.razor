@page "/admin/donor-organizations/{Id}/delete"
@using TimeForCode.Donation.Api.Client
@inject IDonationClient DonationClient
@inject NavigationManager NavigationManager

<PageTitle>Delete Donor Organization - TimeForCode</PageTitle>

<h1>Delete Donor Organization</h1>

@if (_error != null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_orgName != null)
{
    <p>Are you sure you want to delete <strong>@_orgName</strong>?</p>

    <form method="post" @formname="delete-donor-org">
        <AntiforgeryToken />
        <input type="hidden" name="Form.Confirm" value="true" />
        <button type="submit" class="btn btn-danger me-2">Delete</button>
    </form>
    <a href="/admin/donor-organizations" class="btn btn-secondary mt-2">Cancel</a>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public DeleteOrgForm? Form { get; set; }

    public class DeleteOrgForm
    {
        public bool Confirm { get; set; }
    }

    private string? _error;
    private string? _orgName;

    protected override async Task OnInitializedAsync()
    {
        if (Form?.Confirm == true)
        {
            try
            {
                await DonationClient.DeleteDonorOrganizationAsync(Id);
                NavigationManager.NavigateTo("/admin/donor-organizations");
            }
            catch
            {
                _error = "Could not delete donor organization.";
                await LoadOrgNameAsync();
            }
        }
        else
        {
            await LoadOrgNameAsync();
        }
    }

    private async Task LoadOrgNameAsync()
    {
        try
        {
            var org = await DonationClient.GetDonorOrganizationByIdAsync(Id);
            _orgName = org.Name;
        }
        catch
        {
            NavigationManager.NavigateTo("/admin/donor-organizations");
        }
    }
}
