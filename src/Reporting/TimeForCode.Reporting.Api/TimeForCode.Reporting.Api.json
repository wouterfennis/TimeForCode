{
  "openapi": "3.1.1",
  "info": {
    "title": "Reporting API",
    "description": "API for the impact report and contribution history export of donor organizations",
    "version": "v1"
  },
  "paths": {
    "/api/v1/reporting/project/{id}/donation-report": {
      "get": {
        "tags": [
          "ProjectReporting"
        ],
        "summary": "Returns the detailed donation report of a project: hours received and logged, progress, the donations with their statuses and\r\nthe contributors with their hours. Allowed for the maintainer of the project and for administrators.",
        "description": "Only Active and Completed donations count as received; Pending and Cancelled ones are listed and counted per status.\r\nOnly published projects can be reported on; an unpublished project answers 404, also for its maintainer.",
        "operationId": "GetDonationReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The project identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The detailed report; zeros and empty lists when the project has no donations or contributions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDonationReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "The project identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither the maintainer of the project nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The project does not exist or is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The report could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/project/{id}/public-summary": {
      "get": {
        "tags": [
          "ProjectReporting"
        ],
        "summary": "Returns the public summary of a project (anonymous): aggregate totals only, without any personal data.",
        "operationId": "GetPublicSummary",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The project identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The aggregate totals of the project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPublicSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "The project identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The project does not exist or is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The summary could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/donororganization/{id}/impact-report": {
      "get": {
        "tags": [
          "Reporting"
        ],
        "summary": "Returns the impact report of a donor organization: hours pledged and logged, the number of projects supported and the breakdown per project.",
        "description": "Only Active and Completed donations count: a Pending donation is not yet committed and a Cancelled one no longer is.",
        "operationId": "GetImpactReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The donor organization identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The impact report; zeros and an empty breakdown when the organization has no counted donations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "The organization identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither affiliated with the organization nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The donor organization does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The report could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/donororganization/{id}/contribution-history": {
      "get": {
        "tags": [
          "Reporting"
        ],
        "summary": "Exports the contribution history of a donor organization as a CSV or JSON file, earliest contribution first.",
        "description": "CSV columns: ContributionId, ProjectId, ContributorLogin, Hours, GithubReference, LoggedAt (UTC, ISO 8601). JSON has the same\r\nvalues as camel case fields in a `contributions` list. Contributions are attributed by the contributor's current\r\naffiliation, so a contributor who moves to another organization takes their history along. Deleted contributions are left out.",
        "operationId": "GetContributionHistory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The donor organization identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "The file format, `Json` (default) or `Csv`.",
            "schema": {
              "default": "Json",
              "$ref": "#/components/schemas/ExportFormat"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export as a file download in the requested format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContributionHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "The organization identifier or the format is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither affiliated with the organization nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The donor organization does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The export could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContributionHistoryItemResponse": {
        "required": [
          "id",
          "projectId",
          "contributorLogin",
          "hours",
          "loggedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The contribution identifier."
          },
          "projectId": {
            "type": "string",
            "description": "The project the hours were logged on."
          },
          "contributorLogin": {
            "type": "string",
            "description": "GitHub login of the contributor."
          },
          "hours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The hours logged.",
            "format": "int32"
          },
          "githubReference": {
            "type": [
              "null",
              "string"
            ],
            "description": "The GitHub issue or pull request the hours belong to; `null` when none was given."
          },
          "loggedAt": {
            "type": "string",
            "description": "When the hours were logged, in UTC.",
            "format": "date-time"
          }
        },
        "description": "One logged contribution in the export."
      },
      "ContributionHistoryResponse": {
        "required": [
          "contributions"
        ],
        "type": "object",
        "properties": {
          "contributions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContributionHistoryItemResponse"
            },
            "description": "The contributions, earliest first."
          }
        },
        "description": "The JSON shape of the contribution history export. The CSV export has the same values in the columns\r\nContributionId, ProjectId, ContributorLogin, Hours, GithubReference and LoggedAt."
      },
      "DonationStatus": {
        "enum": [
          "Pending",
          "Active",
          "Completed",
          "Cancelled"
        ],
        "description": "Lifecycle state of a donation as the Donation context reports it; duplicated here on purpose (ADR-010)."
      },
      "ExportFormat": {
        "enum": [
          "Json",
          "Csv"
        ],
        "description": "File format of the contribution history export."
      },
      "ImpactReportResponse": {
        "required": [
          "hoursPledged",
          "hoursLogged",
          "projectsSupported",
          "projects"
        ],
        "type": "object",
        "properties": {
          "hoursPledged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours committed by the Active and Completed donations of the organization.",
            "format": "int32"
          },
          "hoursLogged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged on those donations.",
            "format": "int32"
          },
          "projectsSupported": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of different projects the donations were pledged to.",
            "format": "int32"
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectImpactResponse"
            },
            "description": "The breakdown per project, in the order of the first donation to each."
          }
        },
        "description": "What a donor organization pledged and delivered. Only Active and Completed donations count."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProjectContributorResponse": {
        "required": [
          "contributorId",
          "contributorLogin",
          "hours"
        ],
        "type": "object",
        "properties": {
          "contributorId": {
            "type": "string",
            "description": "The contributor identifier."
          },
          "contributorLogin": {
            "type": "string",
            "description": "The GitHub login of the contributor at the time of logging."
          },
          "hours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The total hours the contributor logged on the project.",
            "format": "int32"
          }
        },
        "description": "The hours a contributor logged on the project."
      },
      "ProjectDonationReportResponse": {
        "required": [
          "hoursReceived",
          "hoursLogged",
          "progressPercentage",
          "donorCount",
          "contributorCount",
          "pendingDonations",
          "activeDonations",
          "completedDonations",
          "cancelledDonations",
          "donations",
          "contributors"
        ],
        "type": "object",
        "properties": {
          "hoursReceived": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours committed by the Active and Completed donations of the project.",
            "format": "int32"
          },
          "hoursLogged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged on those donations.",
            "format": "int32"
          },
          "progressPercentage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged against hours received, in whole percent (0 to 100); 0 when nothing was received.",
            "format": "int32"
          },
          "donorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of donors of the Active and Completed donations: an organization counts once, an individual pledge counts as one donor.",
            "format": "int32"
          },
          "contributorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of different contributors who logged hours on the project.",
            "format": "int32"
          },
          "pendingDonations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of Pending donations.",
            "format": "int32"
          },
          "activeDonations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of Active donations.",
            "format": "int32"
          },
          "completedDonations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of Completed donations.",
            "format": "int32"
          },
          "cancelledDonations": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of Cancelled donations.",
            "format": "int32"
          },
          "donations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDonationResponse"
            },
            "description": "Every donation of the project, whatever its status, oldest pledge first."
          },
          "contributors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectContributorResponse"
            },
            "description": "The contributors with their total hours, in the order of their first contribution."
          }
        },
        "description": "The detailed donation report of a project: what it received, who contributed and how far it has progressed."
      },
      "ProjectDonationResponse": {
        "required": [
          "id",
          "status",
          "hoursCommitted",
          "hoursLogged",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The donation identifier."
          },
          "donorOrganizationId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The donor organization of the pledge; absent when pledged as an individual."
          },
          "status": {
            "description": "The lifecycle state: Pending, Active, Completed or Cancelled.",
            "$ref": "#/components/schemas/DonationStatus"
          },
          "hoursCommitted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of hours pledged.",
            "format": "int32"
          },
          "hoursLogged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of pledged hours that were logged on the project.",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "description": "The moment the pledge was made.",
            "format": "date-time"
          }
        },
        "description": "A donation pledged to the project."
      },
      "ProjectImpactResponse": {
        "required": [
          "projectId",
          "hoursPledged",
          "hoursLogged"
        ],
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The project identifier."
          },
          "hoursPledged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours the organization committed to the project.",
            "format": "int32"
          },
          "hoursLogged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged on the project's donations of the organization.",
            "format": "int32"
          }
        },
        "description": "The hours a project received from the organization."
      },
      "ProjectPublicSummaryResponse": {
        "required": [
          "hoursReceived",
          "hoursLogged",
          "progressPercentage",
          "donorCount",
          "contributorCount"
        ],
        "type": "object",
        "properties": {
          "hoursReceived": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours committed by the Active and Completed donations of the project.",
            "format": "int32"
          },
          "hoursLogged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged on those donations.",
            "format": "int32"
          },
          "progressPercentage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hours logged against hours received, in whole percent (0 to 100); 0 when nothing was received.",
            "format": "int32"
          },
          "donorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of donors of the Active and Completed donations.",
            "format": "int32"
          },
          "contributorCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of different contributors who logged hours on the project.",
            "format": "int32"
          }
        },
        "description": "The aggregate totals of a project. Holds no personal data: no names, logins or identifiers of donors or contributors."
      }
    }
  },
  "tags": [
    {
      "name": "ProjectReporting"
    },
    {
      "name": "Reporting"
    }
  ]
}