{
  "openapi": "3.1.1",
  "info": {
    "title": "Reporting API",
    "description": "API for the impact report and contribution history export of donor organizations",
    "version": "v1"
  },
  "paths": {
    "/api/v1/reporting/donororganization/{id}/badges": {
      "get": {
        "tags": [
          "Badge"
        ],
        "summary": "Returns the badges of a donor organization (anonymous), awarding the ones it has newly earned.",
        "description": "An organization is measured on the hours logged on its Active and Completed donations and earns the badges of the\r\ntiers with recipient type `Organization`.",
        "operationId": "GetOrganizationBadges",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The donor organization identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The badges of the organization; an empty list when none was earned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgesResponse"
                }
              }
            }
          },
          "400": {
            "description": "The organization identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The donor organization does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "500": {
            "description": "The badges could not be determined because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/contributor/{id}/badges": {
      "get": {
        "tags": [
          "Badge"
        ],
        "summary": "Returns the badges of a contributor (anonymous), awarding the ones they have newly earned.",
        "description": "A contributor is measured on the total hours they logged themselves and earns the badges of the tiers with recipient\r\ntype `Contributor`. Only badge names and award dates are exposed, no other personal data.",
        "operationId": "GetContributorBadges",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contributor identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The badges of the contributor; an empty list when none was earned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgesResponse"
                }
              }
            }
          },
          "400": {
            "description": "The contributor identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The contributor does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "500": {
            "description": "The badges could not be determined because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/statistics": {
      "get": {
        "tags": [
          "Badge"
        ],
        "summary": "Returns the public impact statistics (anonymous): the total hours logged and the number of donor organizations supported.",
        "operationId": "GetPublicStatistics",
        "responses": {
          "200": {
            "description": "The totals; zeros on a platform without logged hours.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStatisticsResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "500": {
            "description": "The statistics could not be determined because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/badge-tier": {
      "get": {
        "tags": [
          "Badge"
        ],
        "summary": "Returns the configured badge tiers (anonymous), so the thresholds can be shown next to the badges.",
        "operationId": "GetBadgeTiers",
        "parameters": [
          {
            "name": "recipientType",
            "in": "query",
            "description": "Only the tiers of this recipient type; all tiers when omitted.",
            "schema": {
              "$ref": "#/components/schemas/BadgeRecipientType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tiers; an empty list when none is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeTiersResponse"
                }
              }
            }
          },
          "400": {
            "description": "The recipient type is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          },
          "500": {
            "description": "The tiers could not be read because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/badge-tier/{recipientType}/{name}": {
      "put": {
        "tags": [
          "Badge"
        ],
        "summary": "Defines a badge tier, or changes the threshold of the tier with the same recipient type and name (administrators only).",
        "description": "Badges already awarded stay when a threshold is raised. A tier added or lowered is awarded to recipients who already\r\nqualify the next time their badges are requested.",
        "operationId": "DefineBadgeTier",
        "parameters": [
          {
            "name": "recipientType",
            "in": "path",
            "description": "Who the tier is for: `Organization` or `Contributor`.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BadgeRecipientType"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "The tier name, 1 to 100 characters, unique per recipient type.",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The threshold.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineBadgeTierRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineBadgeTierRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DefineBadgeTierRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The tier as saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeTierResponse"
                }
              }
            }
          },
          "400": {
            "description": "The name is empty or longer than 100 characters, or the threshold is not a positive number of hours.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Another tier of the recipient type already has the threshold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The tier could not be saved because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Badge"
        ],
        "summary": "Removes a badge tier (administrators only). Badges already awarded for it stay.",
        "operationId": "RemoveBadgeTier",
        "parameters": [
          {
            "name": "recipientType",
            "in": "path",
            "description": "Who the tier is for: `Organization` or `Contributor`.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BadgeRecipientType"
            }
          },
          {
            "name": "name",
            "in": "path",
            "description": "The tier name.",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The tier was removed.",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "There is no such tier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The tier could not be removed because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/project/{id}/donation-report": {
      "get": {
        "tags": [
          "ProjectReporting"
        ],
        "summary": "Returns the detailed donation report of a project: hours received and logged, progress, the donations with their statuses and\r\nthe contributors with their hours. Allowed for the maintainer of the project and for administrators.",
        "description": "Only Active and Completed donations count as received; Pending and Cancelled ones are listed and counted per status.\r\nOnly published projects can be reported on; an unpublished project answers 404, also for its maintainer.",
        "operationId": "GetDonationReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The project identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The detailed report; zeros and empty lists when the project has no donations or contributions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDonationReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "The project identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither the maintainer of the project nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The project does not exist or is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The report could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
