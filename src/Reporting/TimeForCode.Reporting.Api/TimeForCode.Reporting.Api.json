              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The project does not exist or is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The summary could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/donororganization/{id}/impact-report": {
      "get": {
        "tags": [
          "Reporting"
        ],
        "summary": "Returns the impact report of a donor organization: hours pledged and logged, the number of projects supported and the breakdown per project.",
        "description": "Only Active and Completed donations count: a Pending donation is not yet committed and a Cancelled one no longer is.",
        "operationId": "GetImpactReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The donor organization identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The impact report; zeros and an empty breakdown when the organization has no counted donations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "The organization identifier is not a valid identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither affiliated with the organization nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The donor organization does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The report could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/donororganization/{id}/contribution-history": {
      "get": {
        "tags": [
          "Reporting"
        ],
        "summary": "Exports the contribution history of a donor organization as a CSV or JSON file, earliest contribution first.",
        "description": "CSV columns: ContributionId, ProjectId, ContributorLogin, Hours, GithubReference, LoggedAt (UTC, ISO 8601). JSON has the same\r\nvalues as camel case fields in a `contributions` list. Contributions are attributed by the contributor's current\r\naffiliation, so a contributor who moves to another organization takes their history along. Deleted contributions are left out.",
        "operationId": "GetContributionHistory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The donor organization identifier.",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{24}$",
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "The file format, `Json` (default) or `Csv`.",
            "schema": {
              "default": 0,
              "$ref": "#/components/schemas/ExportFormat"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export as a file download in the requested format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContributionHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "The organization identifier or the format is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The access token is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The caller is neither affiliated with the organization nor an administrator.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The donor organization does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The export could not be built because of an unexpected error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The Donation API could not be reached or answered with an error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BadgeRecipientType": {
        "enum": [
          "Organization",
          "Contributor"
        ],
        "type": "string",
