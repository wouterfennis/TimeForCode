{
  "openapi": "3.1.1",
  "info": {
    "title": "Authorization API",
    "description": "API to interact with the authorization backend",
    "version": "v1"
  },
  "paths": {
    "/api/v1/admin-authentication/registration/options": {
      "post": {
        "tags": [
          "AdminAuthentication"
        ],
        "summary": "Begins the one-time admin passkey registration ceremony. Only available while no admin credential has been claimed yet.",
        "operationId": "AdminRegistrationOptions",
        "requestBody": {
          "description": "The bootstrap secret that proves the caller may claim the admin role.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRegistrationOptionsRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRegistrationOptionsRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRegistrationOptionsRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The passkey creation options (JSON) for the browser and the ceremony id to send back when the ceremony completes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminPasskeyOptionsResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "The bootstrap secret is wrong or an admin credential has already been claimed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin-authentication/registration": {
      "post": {
        "tags": [
          "AdminAuthentication"
        ],
        "summary": "Completes the one-time admin passkey registration ceremony. Only the first successful completion permanently claims the admin role.",
        "operationId": "AdminCompleteRegistration",
        "requestBody": {
          "description": "The bootstrap secret, the credential (JSON) created by the browser and the ceremony id of the options call.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteRegistrationRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteRegistrationRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteRegistrationRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The admin credential was claimed; the access token and refresh token are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "The ceremony is unknown, expired or already used, or the registration was rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin-authentication/authentication/options": {
      "post": {
        "tags": [
          "AdminAuthentication"
        ],
        "summary": "Begins the admin passkey authentication ceremony. Requires an admin credential to already exist.",
        "operationId": "AdminAuthenticationOptions",
        "responses": {
          "200": {
            "description": "The passkey request options (JSON) for the browser and the ceremony id to send back when the ceremony completes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminPasskeyOptionsResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "No admin credential has been registered yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin-authentication/authentication": {
      "post": {
        "tags": [
          "AdminAuthentication"
        ],
        "summary": "Completes the admin passkey authentication ceremony.",
        "operationId": "AdminCompleteAuthentication",
        "requestBody": {
          "description": "The assertion credential (JSON) produced by the browser and the ceremony id of the options call.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteAuthenticationRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteAuthenticationRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCompleteAuthenticationRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The admin signed in; the access token and refresh token are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "The ceremony is unknown, expired or already used, or the assertion was rejected (including a signature counter that did not increase).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Authentication/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login endpoint.",
        "parameters": [
          {
            "name": "IdentityProvider",
            "in": "query",
            "description": "Gets or sets the identity provider for the login request.",
            "schema": {
              "$ref": "#/components/schemas/IdentityProvider"
            }
          },
          {
            "name": "RedirectUri",
            "in": "query",
            "description": "Gets or sets the redirect URI for the login request.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "CodeChallenge",
            "in": "query",
            "description": "Gets or sets the PKCE code challenge: the unpadded base64url SHA-256 hash (43 characters, method S256) of a random verifier\r\nthat only the client holds. The code exchange requires that verifier, which binds the sign-in to the client that started it.",
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the external identity provider's sign-in page.",
            "content": {
              "application/json": { }
            }
          },
          "400": {
            "description": "The redirect uri is not on the list of allowed redirect uris, the code challenge is malformed or the request is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The login could not be started because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Authentication/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Callback endpoint that is being called by the external identity provider. After the redirect initiated by Task&lt;IActionResult&gt; AuthenticationController.LoginAsync(LoginRequestModel loginModel).",
        "parameters": [
          {
            "name": "Code",
            "in": "query",
            "description": "Gets or sets the authorization code.",
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "name": "State",
            "in": "query",
            "description": "Gets or sets the state parameter.",
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Sign-in succeeded and the browser is redirected to the redirect uri given at login, with a single-use code to exchange for tokens.",
            "content": {
              "application/json": { }
            }
          },
          "400": {
            "description": "The authorization code or state is missing, invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The sign-in could not be completed because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Authentication/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Exchanges the single-use code of a completed sign-in for tokens.",
        "requestBody": {
          "description": "The code and the PKCE verifier of the login that produced it.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeCodeRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeCodeRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeCodeRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The access token and refresh token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "The code is unknown, already used or expired, or the verifier does not match the login.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The exchange failed because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Authentication/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh endpoint.",
        "requestBody": {
          "description": "The refresh token the client holds.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A new access token and refresh token. The refresh token that was sent is no longer valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseModel"
                }
              }
            }
          },
          "400": {
            "description": "The refresh token is unknown, expired or was already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The refresh failed because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          },
          "429": {
            "description": "Too many requests. Retry after the number of seconds given in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Number of seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/Authentication/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout endpoint.",
        "requestBody": {
          "description": "The refresh token to revoke.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The refresh token was revoked, if it existed.",
            "content": {
              "application/json": { }
            }
          },
          "500": {
            "description": "The logout failed because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "Jwks"
        ],
        "summary": "Returns the JSON Web Key Set (JWKS) for the application.",
        "responses": {
          "200": {
            "description": "The public keys that verify the signature of issued access tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwksResponse"
                }
              }
            }
          },
          "500": {
            "description": "The key set could not be produced because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "tags": [
          "OpenIdConfiguration"
        ],
        "summary": "Retrieves the OpenID Connect configuration document.",
        "responses": {
          "200": {
            "description": "The OpenID Connect discovery document of this issuer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryDocumentResponse"
                }
              }
            }
          },
          "500": {
            "description": "The document could not be produced because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/User": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get user information.",
        "responses": {
          "200": {
            "description": "The profile of the signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "description": "The signed-in user no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The profile could not be read because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "User"
        ],
        "summary": "Delete the account of the user: removes the profile and refresh tokens and anonymises the contributions.",
        "operationId": "DeleteAccount",
        "responses": {
          "204": {
            "description": "The account and its data were deleted and the token cookies were removed.",
            "content": {
              "application/json": { }
            }
          },
          "401": {
            "description": "The caller is not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The signed-in user no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "The external identity provider could not be reached to revoke the grant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The account could not be deleted because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/User/repositories": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get user's public repositories from GitHub.",
        "responses": {
          "200": {
            "description": "The GitHub repositories of the signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RepositoryResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "The signed-in user no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "GitHub could not be reached or rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The repositories could not be read because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/v1/User/repositories/{owner}/{repo}": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get a single public repository from GitHub by owner and repository name.",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "description": "The GitHub username or organisation that owns the repository (at most 39 characters; letters, digits and single hyphens).",
            "required": true,
            "schema": {
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "description": "The repository name (at most 100 characters; letters, digits, dots, underscores and hyphens).",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "The owner or repository name is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The requested repository.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "The repository does not exist or the signed-in user cannot see it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "GitHub could not be reached or rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "The repository could not be read because of an unexpected server error.",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessToken": {
        "required": [
          "token",
          "expiresAfter"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The signed JSON Web Token (JWT, RS256); send it as a bearer token. Verify it with the keys of the JWKS endpoint."
          },
          "expiresAfter": {
            "type": "string",
            "description": "The moment the token expires, as an ISO 8601 date and time with offset; the token is invalid after this instant.",
            "format": "date-time"
          }
        },
        "description": "A short-lived access token issued by the Authorization API."
      },
      "AdminCompleteAuthenticationRequestModel": {
        "required": [
          "credentialJson",
          "ceremonyId"
        ],
        "type": "object",
        "properties": {
          "credentialJson": {
            "maxLength": 16384,
            "type": "string",
            "description": "The JSON-serialised `PublicKeyCredential` returned by `navigator.credentials.get()`."
          },
          "ceremonyId": {
            "maxLength": 128,
            "type": "string",
            "description": "The ceremony id returned by the options call. It works once and expires after a short time."
          }
        },
        "description": "Completes the admin passkey authentication ceremony."
      },
      "AdminCompleteRegistrationRequestModel": {
        "required": [
          "bootstrapSecret",
          "credentialJson",
          "ceremonyId"
        ],
        "type": "object",
        "properties": {
          "bootstrapSecret": {
            "maxLength": 256,
            "type": "string",
            "description": "Shared secret guarding who may claim the admin role, re-validated on completion."
          },
          "credentialJson": {
            "maxLength": 16384,
            "type": "string",
            "description": "The JSON-serialised `PublicKeyCredential` returned by `navigator.credentials.create()`."
          },
          "ceremonyId": {
            "maxLength": 128,
            "type": "string",
            "description": "The ceremony id returned by the options call. It works once and expires after a short time."
          }
        },
        "description": "Completes the one-time admin passkey registration ceremony. The bootstrap secret is re-validated here."
      },
      "AdminPasskeyOptionsResponseModel": {
        "required": [
          "optionsJson",
          "ceremonyId"
        ],
        "type": "object",
        "properties": {
          "optionsJson": {
            "type": "string",
            "description": "The JSON-serialised WebAuthn options for the browser to pass to `navigator.credentials`."
          },
          "ceremonyId": {
            "type": "string",
            "description": "The opaque id of the ceremony. Send it back when the ceremony completes; the ceremony state itself stays on the server."
          }
        },
        "description": "WebAuthn creation/request options for the browser to pass to `navigator.credentials`."
      },
      "AdminRegistrationOptionsRequestModel": {
        "required": [
          "bootstrapSecret"
        ],
        "type": "object",
        "properties": {
          "bootstrapSecret": {
            "maxLength": 256,
            "type": "string",
            "description": "Shared secret guarding who may claim the admin role."
          }
        },
        "description": "Request to begin the one-time admin passkey registration ceremony."
      },
      "DiscoveryDocumentResponse": {
        "required": [
          "issuer",
          "jwks_uri"
        ],
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "description": "The issuer URL that appears in the `iss` claim of issued tokens"
          },
          "jwks_uri": {
            "type": "string",
            "description": "Absolute URL of the JSON Web Key Set that holds the public keys for verifying token signatures"
          }
        },
        "description": "Response model for the discovery document endpoint."
      },
      "ExchangeCodeRequestModel": {
        "required": [
          "code",
          "codeVerifier"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 2048,
            "type": "string",
            "description": "The single-use code the browser received in the redirect after sign-in. It is valid once and for a short time."
          },
          "codeVerifier": {
            "maxLength": 128,
            "minLength": 43,
            "type": "string",
            "description": "The PKCE code verifier (43 to 128 unreserved characters) whose S256 challenge was sent when the login started.\r\nA code started with another verifier is rejected."
          }
        },
        "description": "Represents the request to exchange the single-use code of a completed sign-in for tokens."
      },
      "IdentityProvider": {
        "enum": [
          "Github"
        ],
        "type": "string",
        "description": "Represents the identity providers supported by the application."
      },
      "JwkResponse": {
        "required": [
          "kty",
          "kid",
          "use",
          "alg",
          "e",
          "n"
        ],
        "type": "object",
        "properties": {
          "kty": {
            "type": "string",
            "description": "Key type; `RSA`"
          },
          "kid": {
            "type": "string",
            "description": "Key identifier, matched against the `kid` header of issued tokens"
          },
          "use": {
            "type": "string",
            "description": "Intended use of the key (`sig` for signature verification)"
          },
          "alg": {
            "type": "string",
            "description": "Signing algorithm the key is used with"
          },
          "e": {
            "type": "string",
            "description": "RSA public exponent, Base64url encoded"
          },
          "n": {
            "type": "string",
            "description": "RSA modulus, Base64url encoded"
          }
        },
        "description": "Response model for JSON Web Key (JWK)."
      },
      "JwksResponse": {
        "required": [
          "keys"
        ],
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JwkResponse"
            },
            "description": "The published signing keys: the current key and, during rotation, the previous one"
          }
        },
        "description": "Response model for JSON Web Key Set (JWKS)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequestModel": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "description": "The refresh token the client holds.",
            "$ref": "#/components/schemas/RefreshToken"
          }
        },
        "description": "Represents a request that carries the refresh token: renewing the tokens or signing out."
      },
      "RefreshToken": {
        "required": [
          "token",
          "expiresAfter"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The opaque refresh token value; single use, it is replaced by a new one on every refresh."
          },
          "expiresAfter": {
            "type": "string",
            "description": "The moment the refresh token expires, as an ISO 8601 date and time with offset; the token is invalid after this instant.",
            "format": "date-time"
          }
        },
        "description": "A long-lived refresh token that is exchanged for a new access token and a new refresh token."
      },
      "RepositoryResponse": {
        "required": [
          "name",
          "url"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name"
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "Repository description"
          },
          "starCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of stars",
            "format": "int32"
          },
          "language": {
            "type": [
              "null",
              "string"
            ],
            "description": "Primary language"
          },
          "url": {
            "type": "string",
            "description": "Repository URL"
          }
        },
        "description": "Repository response model"
      },
      "TokenResponseModel": {
        "required": [
          "accessToken",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "description": "The short-lived access token; send it as a bearer token.",
            "$ref": "#/components/schemas/AccessToken"
          },
          "refreshToken": {
            "description": "The new refresh token. Single use: the one the client sent to refresh is now invalid.",
            "$ref": "#/components/schemas/RefreshToken"
          },
          "isNewUser": {
            "type": "boolean",
            "description": "Indicates whether this is the user's first login (new account was created)."
          }
        },
        "description": "The tokens issued to a client: after a code exchange or a refresh. The client keeps them server-side and never hands them to a browser script."
      },
      "UserResponse": {
        "required": [
          "id",
          "login",
          "nodeId",
          "avatarUrl",
          "name",
          "company",
          "email"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User id"
          },
          "login": {
            "type": "string",
            "description": "User login"
          },
          "nodeId": {
            "type": "string",
            "description": "User node id"
          },
          "avatarUrl": {
            "type": "string",
            "description": "User avatar url"
          },
          "name": {
            "type": "string",
            "description": "User name"
          },
          "company": {
            "type": [
              "null",
              "string"
            ],
            "description": "User company"
          },
          "email": {
            "type": "string",
            "description": "User email"
          },
          "bio": {
            "type": [
              "null",
              "string"
            ],
            "description": "User bio"
          },
          "location": {
            "type": [
              "null",
              "string"
            ],
            "description": "User location"
          }
        },
        "description": "User response model"
      }
    }
  },
