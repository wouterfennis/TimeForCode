# Build the React SPA with the Node version the project targets
FROM node:26-alpine AS spa

WORKDIR /app

# Restore dependencies first so this layer is cached until the lockfile changes
COPY src/Frontend/TimeForCode.Frontend/package.json src/Frontend/TimeForCode.Frontend/package-lock.json ./
RUN npm ci --ignore-scripts

# Build the static files into /app/dist
COPY src/Frontend/TimeForCode.Frontend/ ./
RUN npm run build

# Publish the BFF (ASP.NET host that serves the SPA and forwards /api/* to the APIs)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS bff

WORKDIR /src

COPY Directory.Packages.props Directory.Build.props ./
COPY src/Shared ./src/Shared
COPY src/Frontend/TimeForCode.Frontend.Bff ./src/Frontend/TimeForCode.Frontend.Bff
RUN dotnet publish ./src/Frontend/TimeForCode.Frontend.Bff/TimeForCode.Frontend.Bff.csproj \
    --configuration Release \
    --output /app/publish

# Run the BFF as the image's non-root user (listens on 8080); the SPA build output is its web root
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

WORKDIR /app

COPY --from=bff /app/publish .
COPY --from=spa /app/dist ./wwwroot

USER $APP_UID

EXPOSE 8080

ENTRYPOINT ["dotnet", "TimeForCode.Frontend.Bff.dll"]
