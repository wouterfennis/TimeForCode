{
  "env": {
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "MSBUILDTERMINALLOGGER": "off",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "allow": [
      "Bash(markdownlint:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet build:*)",
      "Bash(gh issue view:*)",
      "Bash(gh auth status)",
      "Bash(podman:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/obj/**)",
      "Read(./package-lock.json)",
      "Read(./docs/images/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Read|Grep|Glob", "hooks": [ { "type": "command", "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.ps1\"", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.ps1\"", "timeout": 15 } ] }
    ]
  }
}
